# Time's Hub | Attribution Intelligence — Environment Variables
# Copy to .env and customize for your deployment
#   cp .env.example .env

# Auth — CHANGE THESE IN PRODUCTION
AUTH_SECRET_KEY=th-dev-secret-change-in-production
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_TOKEN_EXPIRE_MINUTES=480

# Database — leave empty for a local SQLite file (./attribution_hub.db).
# Production: a persistent Postgres URL, e.g. Supabase "Session pooler" URI:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=

# Fernet key that encrypts stored BigQuery credentials. Must stay the same
# across restarts, or saved credentials can no longer be decrypted.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# App port (optional, default 8000)
# APP_PORT=8000
